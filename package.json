{
  "name": "flight-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "json-server --watch db.json --host 0.0.0.0 --port 3000",
    "api:reset": " node scripts/reset-db.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "testc": "jest --coverage",
    "doc": "npx expo-doctor",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@reduxjs/toolkit": "^2.13.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lodash.isequal": "^4.5.0",
    "rand-seed": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-redux": "^9.3.0",
    "redux-devtools-expo-dev-plugin": "^2.0.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/lodash.isequal": "^4.5.8",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "json-server": "^0.17.4",
    "prettier": "3.9.10",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^immer$": "<rootDir>/node_modules/immer/dist/cjs/index.js",
      "^react-redux$": "<rootDir>/node_modules/react-redux/dist/cjs/index.js"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/*.test.{ts,tsx}",
      "!src/test/**",
      "!src/types/**"
    ],
    "coverageReporters": [
      "text-summary",
      "html",
      "lcov"
    ]
  },
  "private": true
}
